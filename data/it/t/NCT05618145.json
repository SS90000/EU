{"id":"NCT05618145","title":"National Database on Primary Sclerosing Cholangitis (PSC)","official":"Multicenter, Nationwide, Observational, Prospective Study Based on the Development of a Primary Sclerosing Cholangitis Patient's Database Linked to a Biological Sample Storage","summary":"Primary sclerosing cholangitis (PSC) a rare, chronic fibroinflammatory disease of the liver.\n\nNo data about the disease epidemiology exist in Italy. Therefore this study aims to develop a national PSC patient database linked to a biological sample storage.","conditions":["Primary Sclerosing Cholangitis"],"interventions":[{"type":"OTHER","name":"Clinical information"}],"criteria":"Inclusion Criteria:\n\n* Willing and able to give informed consent prior to any study specific procedure being performed;\n* Diagnosis of PSC according to the most recent published guidelines (EASL);\n\nExclusion Criteria:\n\n* Subject unwilling to participate at the study","minAge":"17 Years","maxAge":"","sex":"ALL","healthy":false,"studyType":"OBSERVATIONAL","purpose":"","enrollment":6000,"start":"2022-10-21","pcd":"2032-10-21","upd":"2024-01-02","sponsor":"University of Milano Bicocca","areas":["other","rare"],"central":["Pietro Invernizzi, MD · 039 233 2187 · pietro.invernizzi@unimib.it","Marco Carbone, MD · 02 6448 8139 · marco.carbone@unimib.it"],"sites":[{"f":"Ospedali riuniti di Ancona","city":"Ancona","pr":"","zip":"","s":"NYR","lat":43.6072,"lon":13.5103,"c":"Marco Marzioni"},{"f":"Policlinico di Bari","city":"Bari","pr":"","zip":"","s":"NYR","lat":41.1207,"lon":16.8698,"c":"Antonino Castellaneta"},{"f":"ASST Bergamo ovest","city":"Bergamo","pr":"","zip":"","s":"NYR","lat":45.696,"lon":9.6672,"c":"Silvia Colombo"},{"f":"ASST Papa Giovanni XXIII","city":"Bergamo","pr":"","zip":"","s":"NYR","lat":45.696,"lon":9.6672,"c":"Stefano Fagiuoli"},{"f":"Ospedale Sant'Orsola Malpighi","city":"Bologna","pr":"","zip":"","s":"NYR","lat":44.4938,"lon":11.3387,"c":"Luigi Muratori"},{"f":"Policlinico S. Orsola Ma