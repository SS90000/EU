{"id":"NCT05700149","title":"Integrated Molecular and Clinical Profiling to Improve Disease Characterization and Outcome Prediction in Nodal Marginal Zone Lymphoma","official":"Integrated Molecular and Clinical Profiling to Improve Disease Characterization and Outcome Prediction in Nodal Marginal Zone Lymphoma","summary":"International retrospective observational cohort study aimed to describe a molecular classification for NMZL.","conditions":["Nodal Marginal Zone Lymphoma"],"interventions":[],"criteria":"Inclusion Criteria:\n\n1. Male or female adults 18 years or older\n2. Diagnosis of NMZL on lymph node histology after Jan 1st, 2000\n3. Availability of tumor material from lymph node (either frozen or FFPE) collected when the patient was treatment naïve\n4. Availability of the baseline and follow-up annotations\n\nExclusion Criteria:\n\n1\\. Nodal spread of a clinically occult extranodal MZL (this must have been ruled out by carefully evaluating the extranodal tissues draining to the involved lymph nodes by imaging or endoscopy)","minAge":"18 Years","maxAge":"","sex":"ALL","healthy":false,"studyType":"OBSERVATIONAL","purpose":"","enrollment":300,"start":"2024-04-11","pcd":"2026-12-31","upd":"2026-06-22","sponsor":"International Extranodal Lymphoma Study Group (IELSG)","areas":["oncology","rare"],"central":["IELSG - Study Coordination Office · +41586667321 · ielsg@ior.usi.ch","Davide Rossi, MD · +41918118540 · davide.rossi@eoc.ch"],"sites":[{"f":"AO SS Antonio e Biagio e C. Arrigo","city":"Alessandria","pr":"","zip":"15121","s":"R","lat":44.9092,"lon":8.6101,"c":"Gioacchino Catania, MD"},{"f":"Istituto Tumori \"Giovanni Paolo II\" I.R.C.C.S.","city":"Bari","pr":"","zip":"70124","s":"R","lat":41.1207,"lon":16.8698,"c":"Carla Minoia, MD"},{"f":"ASST Papa Giovanni XXIII","city":"Bergamo","pr":"","zip":"24127","s":"R","lat":45.696,"lon":9.6672,"c":"Alessandro Rambaldi, MD"},{"f":"ASST degli Spedali Civili di Brescia","city":"Brescia","pr":"","zip":"25123","s":"R","lat"